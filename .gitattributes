# 统一换行符为 LF，避免 Windows 检出时把 .cir 转成 CRLF 造成比对噪声。
# 网表本身对 CRLF 容忍，但保持逐字节一致能让 check_web_data.py / cir_lint.py 的比对更可靠。
* text=auto eol=lf

# 明确的文本类型
*.cir   text eol=lf
*.md    text eol=lf
*.py    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf

# 二进制文件不做转换
*.png   binary
*.jpg   binary
*.ico   binary
*.pdf   binary
